{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Gustavo4Souza/CalculoGuidaste/app/src/data/tabelas/tabela-carga.schema.json",
  "title": "TabelaCarga",
  "description": "Schema comum para as duas variantes de tabela de carga suportadas pelo simulador (Task 1.3 / RT-DD01). Espelha os tipos TypeScript em app/src/types/guindaste.ts — qualquer mudança precisa ser feita nos dois lugares.",
  "oneOf": [
    {
      "$ref": "#/definitions/tabelaVarianteA"
    },
    {
      "$ref": "#/definitions/tabelaVarianteB"
    },
    {
      "$ref": "#/definitions/tabelaZonaRaio"
    }
  ],
  "definitions": {
    "tabelaVarianteA": {
      "title": "TabelaCargaVarianteA (comprimento + raio + quadrante) — MD-300L",
      "type": "object",
      "required": [
        "guindasteId",
        "comprimentoLancaM",
        "quadrante",
        "pontos"
      ],
      "additionalProperties": false,
      "properties": {
        "guindasteId": {
          "type": "string",
          "description": "Deve bater com um Guindaste.id (ex.: \"MD-300L\")."
        },
        "comprimentoLancaM": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Comprimento de lança discreto desta linha da tabela, em metros."
        },
        "quadrante": {
          "type": "string",
          "enum": [
            "frontal",
            "lateral_traseira"
          ]
        },
        "pontos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "raioM",
              "capacidadeKgf"
            ],
            "additionalProperties": false,
            "properties": {
              "raioM": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "capacidadeKgf": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "description": "Pontos ordenados por raioM crescente. Ausência de um raio na tabela do fabricante para este comprimento (fora do alcance geométrico) significa que o ponto simplesmente não existe nesta lista — não usar null/0."
        }
      }
    },
    "tabelaVarianteB": {
      "title": "TabelaCargaVarianteB (zona + ângulo) — TM-130",
      "type": "object",
      "required": [
        "guindasteId",
        "zona",
        "pontos"
      ],
      "additionalProperties": false,
      "properties": {
        "guindasteId": {
          "type": "string",
          "description": "Deve bater com um Guindaste.id (ex.: \"TM-130\")."
        },
        "zona": {
          "type": "string",
          "enum": [
            "I",
            "II"
          ],
          "description": "Zona de giro — região discreta, nunca interpolada entre si."
        },
        "pontos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "anguloGraus",
              "capacidadeKg"
            ],
            "additionalProperties": false,
            "properties": {
              "anguloGraus": {
                "type": "number",
                "minimum": 0,
                "maximum": 90
              },
              "capacidadeKg": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "description": "Pontos ordenados por anguloGraus crescente, interpolados dentro da zona."
        }
      }
    },
    "tabelaJIB": {
      "title": "TabelaJIB (opcional — só guindastes com possuiJIB = true)",
      "type": "object",
      "required": [
        "guindasteId",
        "comprimentoJibM",
        "anguloJibGraus",
        "quadrante",
        "pontos"
      ],
      "additionalProperties": false,
      "properties": {
        "guindasteId": {
          "type": "string"
        },
        "comprimentoJibM": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "anguloJibGraus": {
          "type": "number"
        },
        "quadrante": {
          "type": "string",
          "enum": [
            "frontal",
            "lateral_traseira"
          ]
        },
        "pontos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "raioM",
              "capacidadeKgf"
            ],
            "additionalProperties": false,
            "properties": {
              "raioM": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "capacidadeKgf": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "tabelaZonaRaio": {
      "title": "TabelaCargaZonaRaio (zona de giro + raio) — lança principal do TM-130",
      "type": "object",
      "required": [
        "guindasteId",
        "zona",
        "pontos"
      ],
      "additionalProperties": false,
      "properties": {
        "guindasteId": {
          "type": "string",
          "description": "Deve bater com um Guindaste.id (ex.: \"TM-130\")."
        },
        "zona": {
          "type": "string",
          "enum": [
            "I",
            "II"
          ],
          "description": "Zona de giro — região discreta, nunca interpolada entre si."
        },
        "pontos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "raioM",
              "capacidadeKg"
            ],
            "additionalProperties": false,
            "properties": {
              "raioM": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "capacidadeKg": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "description": "Um valor por raio (sobre cada arco do diagrama polar), raios crescentes. Entre dois raios: interpolação arredondada para baixo; fora deles: sem dado."
        }
      }
    }
  }
}
